              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotId\": \"{{slotId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set('reservationId', j.reservation._id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('startTime', new Date(Date.now()+3600e3).toISOString());",
                  "pm.collectionVariables.set('endTime', new Date(Date.now()+3*3600e3).toISOString());"
                ]
              }
            }
          ]
        },
        {
          "name": "Same slot again (409 overlap)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
