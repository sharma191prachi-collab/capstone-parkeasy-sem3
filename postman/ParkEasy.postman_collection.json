      "name": "1. Auth",
      "item": [
        {
          "name": "Register manager",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi\",\n  \"email\": \"ravi@test.com\",\n  \"password\": \"123456\",\n  \"role\": \"manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set('managerToken', j.accessToken);",
                  "pm.collectionVariables.set('managerRefresh', j.refreshToken);"
                ]
              }
            }
          ]
        },
